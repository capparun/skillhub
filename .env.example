# 数据库(Zeabur PostgreSQL 服务的连接串)
DATABASE_URL=postgresql://user:password@host:5432/skillhub

# 会话签名密钥(随机长字符串;生产必须更换)
SESSION_SECRET=replace-with-a-long-random-secret

# 下载地址签名密钥(可选,缺省复用 SESSION_SECRET)
# PACKAGE_URL_SECRET=

# 发布包存储目录(Zeabur 持久卷挂载点)
PACKAGE_STORAGE_DIR=/data/packages

# 一次性安装令牌有效期(分钟)
INSTALL_TOKEN_TTL_MINUTES=10

# 下载地址有效期(秒)
DOWNLOAD_URL_TTL_SECONDS=300

# 站点公开地址(决定 cookie Secure 开关与安装 Prompt 里的 URL)
PUBLIC_APP_URL=http://localhost:3000

# 首位管理员(仅 scripts/seed.mjs 首次创建时使用)
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=
