{
  "tenant": "demo",
  "domain": "demo.gllue.invalid",
  "protocol": "https",
  "baseUrl": "https://demo.gllue.invalid",
  "paths": {
    "login": "/",
    "dashboard": "/crm/dashboard/list",
    "candidateSearch": "/crm/candidate/list",
    "candidateDetail": "/crm/candidate/detail",
    "jobSearch": "/crm/joborder/list",
    "jobDetail": "/crm/joborder/detail",
    "clientSearch": "/crm/client/list"
  },
  "delays": {
    "pageLoad": [2000, 4000],
    "readiness": [250, 500],
    "click": [500, 1500],
    "scroll": [800, 2000],
    "input": [100, 300]
  },
  "limits": {
    "defaultSearchLimit": 20,
    "maxSearchLimit": 100,
    "defaultPageSize": 20
  },
  "output": {
    "baseDir": "./output",
    "candidatesDir": "./output/candidates",
    "jobsDir": "./output/jobs",
    "reportsDir": "./output/reports",
    "debugDir": "./output/debug"
  }
}
