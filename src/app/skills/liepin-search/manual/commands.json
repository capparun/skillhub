      {
        "name": "file",
        "type": "string",
        "required": true
      },
      {
        "name": "tab_id",
        "type": "string",
        "required": true
      },
      {
        "name": "expected_url",
        "type": "string",
        "required": true
      }
    ]
  },
  {
    "name": "connect",
    "description": "在官方猎聘Adapter会话中打开搜索页并返回实际标签ID；需明确授权，不用于白屏重试",
    "output": "Adapter会话标签ID与页面地址，未证明登录或业务就绪",
    "args": [
      {
        "name": "replaces_operation_id",
        "type": "string",
        "description": "可选：原独立工作页创建回执；只在Chrome确认该页已不存在时新建替代页，不提交搜索"
      },
      {
        "name": "new_workspace",
        "type": "boolean",
        "default": false,
        "description": "新建搜索标签并保留当前页面；需精确授权newWorkspace:true"
      },
      {
        "name": "file",
        "type": "string",
        "required": true
      },
      {
        "name": "operation_id",
        "type": "string",
        "required": true
      }
    ]
  },
  {
    "name": "current-detail",
    "description": "读取已绑定猎聘详情的可见内容并保存到本地任务；可选择展开经历，不新建或关闭标签",
    "output": "已保存的可见详情、完整性状态及操作状态",
    "args": [
      {
        "name": "expand",
        "type": "boolean",
        "default": false,
        "help": "展开已识别的工作、项目、教育经历按钮"
      },
      {
        "name": "file",
        "type": "string",
        "required": true,
        "help": "已有任务的本机绝对路径"
      },
      {
        "name": "operation_id",
        "type": "string",
        "required": true,
        "help": "已授权的稳定操作ID"
      },
      {
        "name": "tab_id",
        "type": "string",
        "required": true,
        "help": "官方会话实际绑定的标签ID"
      },
      {
        "name": "resume_id",
        "type": "string",
        "required": true,
        "help": "已观察到的唯一简历ID"
      }
    ]
  },
  {
    "name": "detail-batch",
    "description": "继续本地已创建并授权的详情队列，逐条保存并返回搜索页；跳过已完成项，未知状态暂停",
    "output": "持久批次及各详情完成状态",
