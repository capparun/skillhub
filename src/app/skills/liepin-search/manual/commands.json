      {
        "name": "file",
        "type": "string",
        "required": true
      },
      {
        "name": "id",
        "type": "string",
        "required": true
      },
      {
        "name": "tab_id",
        "type": "string",
        "required": true
      },
      {
        "name": "interval_ms",
        "type": "int",
        "min": 1000,
        "max": 60000,
        "default": 6000
      }
    ]
  },
  {
    "name": "detail-review",
    "description": "继续本运行时保留的详情：完成证据评估后按授权收藏，或关闭并返回列表；不重复打开",
    "output": "收藏回读或审阅关闭结果",
