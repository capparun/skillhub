  {
    "name": "favorites",
    "description": "读取已绑定的猎聘收藏列表，可在独立工作标签核验；支持组内全文搜索与简历ID核验；不更改收藏、不翻页",
    "output": "当前可见收藏条目及保存结果",
    "args": [
      {
        "name": "keyword",
        "type": "string",
        "description": "可选：收藏全文关键词，选组后输入；空字符串清除搜索。无命中不等于未收藏"
      },
      {
        "name": "resume_ids",
        "type": "string",
        "description": "可选：待核验简历ID，以英文逗号分隔，须指定group；按观察到的链接精确比对"
      },
      {
        "name": "after_operation_id",
        "type": "string",
        "description": "可选：同组已完成收藏/取消的操作ID；据此登记写后新核验，原读取回执仍保留"
      },
      {
        "name": "workspace",
        "type": "boolean",
        "default": false,
        "description": "新建人才管理工作页，读取后关闭；tab_id 为保留的原页面，须授权 workspace:true 请求"
      },
      {
        "name": "file",
        "type": "string",
        "required": true
      },
      {
        "name": "operation_id",
        "type": "string",
        "required": true
      },
      {
        "name": "tab_id",
        "type": "string",
        "required": true
      },
      {
        "name": "limit",
        "type": "int",
        "min": 1,
        "max": 30,
        "default": 3
      },
      {
        "name": "group",
        "type": "string",
        "description": "可选：准确收藏分组名，仅切换视图并回读，不增删收藏"
      }
    ]
  },
